{
  "name": "hiking-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "python ../tools/build_hikes.py",
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "dev:phone": "vite --host --port 5180 --strictPort",
    "build": "npm run data && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "preview:phone": "vite preview --host --port 4180 --strictPort",
    "predeploy": "npm run build && node scripts/check-book.js public",
    "deploy": "gh-pages -d dist",
    "deploy:wedding": "npm run build && node scripts/check-book.js wedding && wrangler pages deploy dist-wedding --project-name dn-wedding --branch main"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.0.0",
    "@fontsource/source-serif-4": "^5.0.0",
    "d3": "^7.9.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "gh-pages": "^6.1.1",
    "vite": "^8.2.0",
    "wrangler": "^4.169.0"
  }
}

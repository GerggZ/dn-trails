{
  "name": "hiking-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "python ../tools/build_hikes.py",
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "dev:phone": "vite --host --port 5180 --strictPort",
    "build": "npm run data && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "preview:phone": "vite preview --host --port 4180 --strictPort",
    "predeploy": "npm run check && npm run build && node scripts/check-book.js public && npm run test:e2e",
    "deploy": "gh-pages -d dist",
    "deploy:wedding": "npm run check && npm run build && node scripts/check-book.js wedding && npm run test:e2e && wrangler pages deploy dist-wedding --project-name dn-wedding --branch main",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.0.0",
    "@fontsource/source-serif-4": "^5.0.0",
    "@sentry/browser": "^11.20.0",
    "d3": "^7.9.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sentry/vite-plugin": "^11.20.0",
    "eslint": "^10.16.0",
    "gh-pages": "^6.1.1",
    "globals": "^17.14.0",
    "vite": "^8.2.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  }
}

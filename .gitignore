# --- Web (web/) ---
node_modules
dist
*.local
*.log

# Generated by tools/build_hikes.py (rebuild any time)
web/public/data/
web/public/photos/
web/public/backgrounds/

# --- Python (tools/) ---
.venv/
__pycache__/
*.pyc

# --- Hike photos ---
# Original photos are large, so they are not committed by default.
# Keep a backup of hikes/*/photos somewhere else (OneDrive, Google Photos, …),
# or delete these two lines to commit them anyway.
hikes/*/photos/*
!hikes/*/photos/.gitkeep

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
